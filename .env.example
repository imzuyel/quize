# ---------------------------------------------------------------
# PGTSC Quiz Arena — environment configuration
# Copy to .env and fill in real values before going live.
# ---------------------------------------------------------------

# REQUIRED — PostgreSQL connection string
# Supabase: Project Settings → Database → Connection string → URI
# Use the pooled (pgbouncer, port 6543) URL on serverless hosts like Vercel.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# REQUIRED FOR PRODUCTION — turn the one-click demo bypass OFF.
# While this is unset or "true", ANYONE can enter any dashboard (including
# admin) without a password. Always set it to false on a public deployment.
DEMO_MODE=false

# AI PROVIDER — without a key the built-in offline generator is used
# (works, but noticeably lower question quality). Set exactly one.
#
# You may set SEVERAL keys — the app tries them in order and automatically
# falls through to the next one if a provider is down, rate limited or out of
# credit. Only if all fail does it use the offline built-in generator.
#
# Default order: Gemini → Groq → OpenAI → Anthropic → custom
#
# ⭐ Google Gemini — permanent free tier, no credit card.
#    Key: https://aistudio.google.com/apikey   (GOOGLE_API_KEY also works)
GEMINI_API_KEY=
#
# Groq — free tier, very fast. Key: https://console.groq.com/keys
GROQ_API_KEY=
#
# Paid providers (optional)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
#
# Overrides
# AI_PROVIDER=gemini               # force which provider is tried first
# AI_MODEL=gemini-3.5-flash        # verified working models:
#                                  #   gemini-3.5-flash, gemini-3-flash-preview
#                                  #   openai/gpt-oss-120b (Groq)

# OPTIONAL — any OpenAI-compatible endpoint
# AI_BASE_URL=https://your-endpoint/v1
# AI_API_KEY=...
